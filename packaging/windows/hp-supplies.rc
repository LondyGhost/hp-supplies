// hp-supplies resource script (icon + manifest + version info)
#include <windows.h>

1 ICON "hp-supplies.ico"

1 VERSIONINFO
FILEVERSION     1,2,1,0
PRODUCTVERSION  1,2,1,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "hp-supplies - HP printer supplies monitor"
      VALUE "FileVersion",     "1.2.1.0"
      VALUE "ProductName",     "hp-supplies"
      VALUE "ProductVersion",  "1.2.1.0"
      VALUE "LegalCopyright",  "MIT License"
      VALUE "OriginalFilename","hp-supplies.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

1 24 "app.manifest"
